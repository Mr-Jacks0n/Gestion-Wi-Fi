# ================= Adven's Manager — env template =================
# Copiez ce fichier en `.env` puis REMPLISSEZ les valeurs réelles.
#    cp .env.example .env && openssl rand -hex 32   # SECRET_KEY
# Ce fichier ne doit JAMAIS contenir de vrais secrets (il est versionné).

# --- Application ---
DEBUG=false

# --- JWT (OBLIGATOIRE) ---
# openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-64

# --- Base de données PostgreSQL (local dev) ---
POSTGRES_USER=advens
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=advens_manager
DATABASE_URL=postgresql://advens:replace-me@localhost:5432/advens_manager

# --- Redis / Celery ---
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@127.0.0.1:6379/2

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# --- Mode « app installée » (install-ubuntu.sh gère ces variables) ---
# FRONTEND_DIST_DIR=/home/you/.local/share/advens-manager/frontend-dist
# APP_PORT=8000
# DOCS_ENABLED=false

# --- Compte admin initial ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123      # changez immédiatement après 1ʳᵉ connexion
INITIAL_ADMIN_PHONE=+225 0000000000

# --- Tunnel (facultatif, TURNED OFF par défaut) ---
# NGROK_AUTHTOKEN=
